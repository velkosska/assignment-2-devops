# Copy to .env for local development: cp .env.example .env
# Local-only values. SQL Server needs 8+ characters with upper, lower, digit and symbol.
# Keep them URL-safe (letters, digits, - and _) because they go into DATABASE_URL,
# and without quotes because db/init.sql puts them inside a SQL string.
MSSQL_SA_PASSWORD=Local-Sa_Passw0rd
CATALOG_DB_PASSWORD=Local-Catalog_Passw0rd
LOANS_DB_PASSWORD=Local-Loans_Passw0rd
